# Safe defaults: delivery remains disabled until both Railway and Sheet gates agree.
GOOGLE_SHEET_ID=replace-with-google-sheet-id
WORKER_ENABLED=false
GOOGLE_SERVICE_ACCOUNT_JSON=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
OPENROUTER_REASONING_EFFORT=high
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX=replace-with-agentmail-inbox
AGENTMAIL_SEND_ENABLED=false
TEST_MODE=true
TIMEZONE=America/Los_Angeles
SEND_HOUR_LOCAL=7
SEND_MINUTE_WINDOW=20
COLLECTION_CONCURRENCY=6
SOURCE_TIMEOUT_SECONDS=20
MAX_CANDIDATES_PER_RUN=60
LOG_LEVEL=INFO
